{
  "name": "my-bike",
  "version": "1.0.0",
  "description": "MyBike Landing Page",
  "scripts": {
    "start": "parcel src/index.html --port 3000",
    "style-format": "stylelint 'src/**/*.scss' --fix --allow-empty-input",
    "format": "prettier --ignore-path .prettierignore --write './src/**/*.{html,css,scss}'",
    "lint": "npm run style-format && npm run format && eslint src/scripts/**/*.js",
    "build": "parcel build src/index.html --dist-dir dist",
    "test": "npm run lint"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@parcel/transformer-sass": "^2.12.0",
    "eslint": "^8.57.0",
    "eslint-plugin-node": "^11.1.0",
    "parcel": "^2.12.0",
    "prettier": "^3.3.2",
    "stylelint": "^16.7.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-scss": "^6.4.1"
  },
  "browserslist": [
    "last 2 versions"
  ]
}
